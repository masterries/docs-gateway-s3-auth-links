# The demo's settings. Fixed values for a local trial, never for real data.
ENV_FILE=demo/demo.env
PUBLIC_HOST=docs.localhost
PUBLIC_URL=https://docs.localhost:9443
HTTPS_BIND=127.0.0.1:9443
KEYCLOAK_ISSUER=http://keycloak.localhost:8080/realms/demo
KEYCLOAK_CLIENT_ID=docs
KEYCLOAK_CLIENT_SECRET=demoClientSecret
SESSION_SECRET=demoSessionSecretNotForRealUse0123456789
S3_ENDPOINT=http://rustfs:9000
ACCESS_LOG=full
