{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::demo-data/shared/*", "arn:aws:s3:::demo-data/finance/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::demo-data"],
      "Condition": {"StringLike": {"s3:prefix": ["", "shared/*", "finance/*"]}}
    },
    {
      "Effect": "Deny",
      "Action": ["s3:*"],
      "Resource": ["arn:aws:s3:::*"],
      "Condition": {"StringEquals": {"s3:authType": ["REST-QUERY-STRING"]}}
    }
  ]
}
