{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [
    { "name": "demo-finance" },
    { "name": "demo-engineering" }
  ],
  "users": [
    {
      "username": "alice", "enabled": true, "emailVerified": true,
      "email": "alice@example.com", "firstName": "Alice", "lastName": "Demo",
      "credentials": [{ "type": "password", "value": "alice" }],
      "groups": ["/demo-finance"]
    },
    {
      "username": "bob", "enabled": true, "emailVerified": true,
      "email": "bob@example.com", "firstName": "Bob", "lastName": "Demo",
      "credentials": [{ "type": "password", "value": "bob" }],
      "groups": ["/demo-engineering"]
    },
    {
      "username": "carol", "enabled": true, "emailVerified": true,
      "email": "carol@example.com", "firstName": "Carol", "lastName": "Demo",
      "credentials": [{ "type": "password", "value": "carol" }]
    }
  ],
  "clients": [
    {
      "clientId": "docs",
      "name": "Document links",
      "enabled": true,
      "publicClient": false,
      "secret": "demoClientSecret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["https://docs.localhost:9443/.auth/callback"],
      "webOrigins": [],
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300",
        "post.logout.redirect.uris": "https://docs.localhost:9443/.auth/signed-out"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ]
}
