# Copy to .env, fill in, chmod 600.
PUBLIC_HOST=docs.example.com
PUBLIC_URL=https://docs.example.com
# Address and port on this server. If something else holds 443, use another port, and add it to PUBLIC_URL
# and to the two URIs of the Keycloak client.
HTTPS_BIND=443

KEYCLOAK_ISSUER=https://keycloak.example.com/realms/example
KEYCLOAK_CLIENT_ID=docs
# Secrets: letters and digits only, because Compose changes values holding $ or #.
KEYCLOAK_CLIENT_SECRET=change-me
# At least 32 characters: openssl rand -hex 32
SESSION_SECRET=change-me

# Reachable from a container. https is checked against certs/ca.pem. For a RustFS on this same server
# that publishes its port without TLS, not only on 127.0.0.1: http://host.docker.internal:9000
S3_ENDPOINT=https://rustfs.example.com
S3_REGION=us-east-1

# Who read what: off, anonymous or full. See "Access log" in the README.
ACCESS_LOG=off
# For anonymous: at least 32 characters. openssl rand -hex 32
ACCESS_LOG_KEY=
